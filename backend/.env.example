# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.

# --- Server ---
# Leave PORT unset in production; hosts like Render provide their own.
PORT=5000

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_actual_mysql_root_password
DB_NAME=healthtrack
DB_PORT=3306

# Set DB_SSL=true when connecting to a hosted MySQL (Aiven, Railway,
# cPanel...). Leave it out for a local MySQL install.
# DB_SSL=true
# Only add this if the connection fails with a self-signed certificate error:
# DB_SSL_REJECT_UNAUTHORIZED=false

# --- Auth ---
# Generate a fresh one for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=any_long_random_string_you_want

# Password given to the 'admin' account by `npm run seed:admin`.
# Always set this before seeding a public deployment.
ADMIN_PASSWORD=choose_a_strong_admin_password

# --- CORS ---
# Must match the frontend's URL exactly, including the port.
# Local development:
CORS_ORIGIN=http://localhost:3000
# Production example:
# CORS_ORIGIN=https://healthtrack.vercel.app
