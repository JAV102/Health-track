# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.

# --- Server ---
# Leave PORT unset in production; hosts like Render provide their own.
PORT=5000

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_actual_mysql_root_password
DB_NAME=healthtrack
DB_PORT=3306

# Connecting to a hosted MySQL instead of a local one? Two things change:
#
#   1. Use the provider's PUBLIC address, not its internal one. Railway, for
#      example, gives you MYSQLHOST=mysql.railway.internal, which only
#      resolves inside Railway's own network — Render cannot reach it. Turn
#      on Public Networking to get a TCP proxy address instead, which looks
#      like <name>.proxy.rlwy.net with a 5-digit port (never 3306).
#
#   2. Turn on SSL. Most hosted providers refuse unencrypted connections,
#      and most present a self-signed certificate, so verification has to be
#      off or the handshake fails with "self-signed certificate in chain".
#
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# --- Auth ---
# Generate a fresh one for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=any_long_random_string_you_want

# Password given to the 'admin' account by `npm run seed:admin`.
# Always set this before seeding a public deployment.
ADMIN_PASSWORD=choose_a_strong_admin_password

# --- CORS ---
# Must match the frontend's URL exactly: right scheme, right port, and no
# trailing slash. A mismatch does not produce a useful error — the API keeps
# working when called directly, while every request from the browser fails
# with a generic "Load failed" / "Failed to fetch".
#
# Leaving this unset allows ALL origins, which is convenient while testing
# but should not be how a deployed site stays.
#
# Local development:
CORS_ORIGIN=http://localhost:3000
# Production example:
# CORS_ORIGIN=https://healthtrack.vercel.app
